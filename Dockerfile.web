# ── Dockerfile.web ────────────────────────────────────────
# 프론트(React/Vite) 빌드 → nginx 정적 서빙 + /api 프록시.
# 백엔드 Dockerfile 과 별개. 이미지: tnosh7/blog-web
# 경로 전제: 이 파일이 백엔드 루트(frontend/의 부모)에 위치, 프론트 소스는 ./frontend

# ── Java 코드 실행 자산 ───────────────────────────────────
# CheerpJ(브라우저 JVM)가 /app/cheerpj/ 의 javac 로 게시글 Java 코드를 컴파일.
# 바이너리(약 16MB)를 git 에 넣지 않으려고 빌드 때 OpenJDK 17(Temurin, GPLv2+CE) 에서 생성.
FROM eclipse-temurin:17-jdk AS javarunner
COPY scripts/build-java-runner-assets.sh /tmp/build.sh
RUN sh /tmp/build.sh /out


# ── Build stage ───────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /build

# corepack으로 pnpm 활성화 (로컬/CI와 도구 통일)
RUN corepack enable

# 의존성 먼저 복사 → 레이어 캐시 활용 (소스만 바뀌면 install 재실행 안 함)
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# 소스 복사 후 빌드 (tsc -b && vite build → dist/ 생성)
COPY frontend/ ./
RUN pnpm build

# ── Runtime stage ─────────────────────────────────────────
FROM nginx:alpine

# 기본 nginx.conf 제거 후 우리 설정 사용 (compose 볼륨 마운트)
RUN rm /etc/nginx/conf.d/default.conf

# 빌드 산출물(dist)을 nginx 웹 루트로
COPY --from=builder /build/dist /usr/share/nginx/html

# Java 실행 자산 → https://lucium.dev/cheerpj/...
COPY --from=javarunner /out/ /usr/share/nginx/html/cheerpj/

# nginx.conf 는 compose 에서 볼륨 마운트하므로 여기선 복사 안 함
# (SSL 인증서 경로가 런타임에 마운트되어야 하기 때문)

EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]
