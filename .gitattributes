* text=auto eol=lf

# 명시적 LF 강제
*.java   text eol=lf
*.kt     text eol=lf
*.gradle text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.properties text eol=lf

# 윈도우 전용은 CRLF 유지
*.bat    text eol=crlf
*.cmd    text eol=crlf

# 바이너리 명시 — 줄바꿈 변환 금지
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.pdf    binary
*.jar    binary
*.zip    binary
*.gz     binary
*.ico    binary
